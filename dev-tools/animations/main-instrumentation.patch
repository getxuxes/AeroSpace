diff --git a/Sources/AppBundle/layout/AnimationStats.swift b/Sources/AppBundle/layout/AnimationStats.swift
new file mode 100644
index 00000000..fd41999b
--- /dev/null
+++ b/Sources/AppBundle/layout/AnimationStats.swift
@@ -0,0 +1,22 @@
+import Foundation
+import QuartzCore
+
+// Measurement-only patch for main, applied by dev-tools/animations/ab-compare.sh to its main worktree so both builds
+// log the same `frame`/`end`/`tick` lines (see AnimationStats.swift on the animations branch). Never committed to main.
+final class AnimationStats: Sendable {
+    static let shared: AnimationStats? = ProcessInfo.processInfo.environment["AEROSPACE_ANIMATION_STATS"]
+        .flatMap(AnimationStats.init(path:))
+    private let lock = NSLock()
+    private let file: FileHandle
+    private init?(path: String) {
+        guard FileManager.default.createFile(atPath: path, contents: nil), let file = FileHandle(forWritingAtPath: path) else { return nil }
+        self.file = file
+    }
+    func log(_ line: String) {
+        let data = Data((line + "\n").utf8)
+        lock.withLock { file.write(data) }
+    }
+    func logFrame(_ windowId: UInt32, _ r: Rect) {
+        log("frame \(CACurrentMediaTime()) \(windowId) \(r.topLeftX) \(r.topLeftY) \(r.width) \(r.height)")
+    }
+}
